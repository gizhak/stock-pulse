# Backend Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stock-pulse?retryWrites=true&w=majority

# Stock Data Provider (Yahoo Finance is free, no API key needed)
# Using yahoo-finance2 npm package

# AI Analysis - Claude API (OPTIONAL - not needed for basic functionality)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Note: Claude API is optional. Stock Pulse works great without it!
# Default behavior: Hebrew explanations are auto-generated from indicators
# Cost: ~$3-5/month if used (free tier: $5/month)

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Auto-scan settings
AUTO_SCAN_ENABLED=false
SCAN_INTERVAL_MINUTES=60

# Frontend Environment Variables
# Create a .env file in frontend/ with:
REACT_APP_API_URL=http://localhost:3000/api
